{
  "name": "Drishti",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "bundle:js": "npm run bundle:js:android && npm run bundle:js:ios",
    "bundle:js:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/js/android/index.android.bundle --assets-dest dist/js/android",
    "bundle:js:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/js/ios/main.jsbundle --assets-dest dist/js/ios",
    "release:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "release:ios": "bash scripts/build-ios-release.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "^2.21.2",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-permissions": "^5.6.3",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "^4.14.1",
    "react-native-screens": "^4.4.0",
    "react-native-tts": "^4.1.1",
    "react-native-vision-camera": "^4.6.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
